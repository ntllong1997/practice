# Server-only values (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Long random string. Its bcrypt hash is stored in salon.settings.app_key_hash.
SALON_SECRET=change-me

# Shown on the check-in page
NEXT_PUBLIC_SALON_NAME=Nail Salon
